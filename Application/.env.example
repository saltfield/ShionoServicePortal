# Laravel アプリ設定（Document/architecture/deploy.md の「Application/.env の要点」対応）
# 本番では APP_KEY・DB パスワード・MAIL_* を必ず差し替えること。

APP_NAME=SSP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
# メール本文のリンク／ボタン URL のベース（例: http://localhost:8080 や https://ssp.example.com）
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
# compose 内なら mariadb。Develop/.env の MYSQL_* / DB_* と一致させる
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=ssp
DB_USERNAME=ssp
DB_PASSWORD=sspsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# 開発: Mailpit（UI http://localhost:8025 / コンテナ名 mailpit:1025）
# 本番: 実 SMTP。MAIL_SCHEME は tls/smtps 等（旧 MAIL_ENCRYPTION は使わない）
# メール内 URL は上記 APP_URL から生成される
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ssp.local"
MAIL_FROM_NAME="${APP_NAME}"
# 本番 SMTP 例:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=your-user
# MAIL_PASSWORD=your-password

VITE_APP_NAME="${APP_NAME}"
