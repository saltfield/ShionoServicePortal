# Copy to .env and adjust for local development.
# SSL / reverse proxy is handled outside this compose stack.

MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=ssp
MYSQL_USER=ssp
MYSQL_PASSWORD=sspsecret

# App connection (used later by Laravel in Application/.env)
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=ssp
DB_USERNAME=ssp
DB_PASSWORD=sspsecret

APP_URL=http://localhost:8080
MAIL_HOST=mailpit
MAIL_PORT=1025
TZ=Asia/Tokyo
