# Develop/.env — Docker Compose 用（リポジトリにコミットしない）
# SSL / リバースプロキシは本スタック外。
#
# Laravel 本体の設定は Application/.env を参照（下の「同期メモ」を転記する）。
# デプロイ要点: Document/architecture/deploy.md

# Compose が ${APP_NAME} を展開する WARN 回避（任意）
APP_NAME=SSP

# --- MariaDB（compose が参照） ---
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=ssp
MYSQL_USER=ssp
MYSQL_PASSWORD=sspsecret

# --- 同期メモ: Application/.env の DB_* と一致させること ---
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=ssp
DB_USERNAME=ssp
DB_PASSWORD=sspsecret

# --- 同期メモ: Application/.env 側が正（compose 本体は未使用） ---
# メール内リンク・ボタン URL のベース。公開 URL に合わせること。
# APP_URL=http://localhost:8080
# APP_TIMEZONE=Asia/Tokyo
#
# キュー（メール通知の ShouldQueue 消化）。compose の ssp-queue が queue:work する。
# QUEUE_CONNECTION=database
#
# 開発: Mailpit（UI http://localhost:8025 / SMTP mailpit:1025）
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_SCHEME=null
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="noreply@ssp.local"
# MAIL_FROM_NAME=SSP
#
# 本番 SMTP 例:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=your-user
# MAIL_PASSWORD=your-password

TZ=Asia/Tokyo
